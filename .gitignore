# Allowlist: everything is ignored except the files listed here, so a working setup with emulators, ROMs, games,
# notes and test output in the same folder can never be committed by accident. To add something new to the
# repository, add a "!" line for it.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/build.ps1
!/docs/
!/launcher/
!/config/
!/tools/

# config: only the example, the generic templates and the art readme
/config/*
!/config/games.example.json
!/config/art/
/config/art/*
!/config/art/README.md
!/config/templates/
/config/templates/*
!/config/templates/demulshooter/
!/config/templates/flycast/
!/config/templates/pcsx2/
!/config/templates/rpcs3/
!/config/templates/supermodel/

# tools: only the published ones
/tools/*
!/tools/aimrig/
!/tools/dupshot/
!/tools/mamectl/
!/tools/mempatch/
!/tools/ps2mem/
!/tools/ps3mem/
!/tools/rpcs3hold/
!/tools/sessions/
/tools/aimrig/scripts/

# Build output, logs and scratch files anywhere
bin/
obj/
*.user
*.log
*.cand
snap/
/tools/mamectl/cmd.txt
/tools/mamectl/fields.txt
